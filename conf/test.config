/*
 * Minimal end-to-end test: simulated 10x v3 reads for 2 samples x 150 cells.
 * Runs in about a minute on 2 CPUs.
 *
 *   nextflow run . -profile test
 */

params {
    simulate       = true
    outdir         = 'results_test'
    expected_cells = 150
    min_genes      = 30
    n_hvg          = 118
    n_pcs          = 15
    // scrublet needs realistic cell numbers; on 150 simulated singlets it only removes true cells
    skip_doublets  = true
}

process {
    withLabel: process_low    { cpus = 1; memory = 1.GB; time = 10.m }
    withLabel: process_medium { cpus = 2; memory = 3.GB; time = 10.m }
}
