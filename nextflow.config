manifest {
    name            = 'scbatchflow'
    description     = 'Single-cell RNA-seq from raw 10x reads to benchmarked batch integration, with results in PostgreSQL'
    version         = '0.2.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    // input
    input          = null            // samplesheet CSV: sample,batch,fastq_1,fastq_2[,technology]
    outdir         = 'results'
    simulate       = false           // generate a tiny simulated dataset instead of --input

    // reference: either a prebuilt kallisto index + t2g, or a genome FASTA + GTF to build one
    kb_index       = null
    t2g            = null
    genome_fasta   = null
    gtf            = null
    technology     = '10xv3'         // default chemistry (see `kb --list`); a samplesheet 'technology' column overrides it per sample
    whitelist      = null            // barcode on-list; kb supplies the 10x lists by default

    // cell QC
    expected_cells = 3000
    min_genes      = 200
    max_pct_mito   = 20
    mito_mads      = 5               // MAD-based mito cut, capped at max_pct_mito; 0 disables
    skip_doublets  = false
    skip_fastqc    = false

    // analysis
    markers        = "${projectDir}/assets/markers_pbmc.json"
    n_hvg          = 2000
    n_pcs          = 30
    batch_key      = 'sample'        // obs column to integrate over: 'sample' or 'batch'
    methods        = 'pca,harmony,combat'
    final_method   = 'best'          // 'best' = highest overall score, or a method name
    resolution     = 0.8
    seed           = 0

    // results database, e.g. postgresql+psycopg2://user:pass@localhost:5432/scbatchflow
    db_url         = null
    run_id         = null            // defaults to the Nextflow run name
}

process {
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = 8.h
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g) --add-host=host.docker.internal:host-gateway'
        process.container = 'scbatchflow:0.2.0'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://ghcr.io/stef1949/scbatchflow:0.2.0'
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
